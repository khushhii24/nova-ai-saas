# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# --- Build output -----------------------------------------------------------
# dist/ is produced by `npm run build`. Vercel and Netlify build from source,
# so a committed bundle would only ever be stale.
dist/
dist-ssr/
build/
out/

# --- Caches -----------------------------------------------------------------
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# --- Environment / secrets --------------------------------------------------
# NOVA has no runtime configuration today, but an ignored .env is cheaper than
# a leaked one. Commit .env.example instead if that ever changes.
.env
.env.*
!.env.example

# --- Deploy CLI local state -------------------------------------------------
.vercel/
.netlify/

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test / coverage --------------------------------------------------------
coverage/
.nyc_output/

# --- Editors ----------------------------------------------------------------
.idea/
*.swp
*.swo
.vscode/*
# Shared editor config is worth committing; personal settings are not.
!.vscode/extensions.json
!.vscode/settings.json

# --- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Local-only scratch -----------------------------------------------------
*.local
/tmp/
/scratch/
