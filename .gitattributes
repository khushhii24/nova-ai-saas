# Normalise line endings so the repo does not show as wholly modified when it
# is cloned on a different platform. Text files are stored LF in the repo and
# checked out native.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# Generated; collapse in PR diffs.
package-lock.json linguist-generated=true -diff
